{
  "expo": {
    "name": "kenni",
    "slug": "kenni",
    "scheme": "kenni",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-audio"
    ]
  }
}
